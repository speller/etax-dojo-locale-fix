{
  "manifest_version": 3,
  "name": "e-Tax Dojo Japanese Locale Fix",
  "version": "1.0.0",
  "description": "Fixes Japanese locale initialization on e-Tax. Source: https://github.com/speller/etax-dojo-locale-fix",
  "content_scripts": [
    {
      "matches": [
        "https://*.e-tax.nta.go.jp/*"
      ],
      "js": [
        "fix-locale.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
